# Storage Invaders - Environment Variables Template
# Copy to .env for local development

PORT=8080
NODE_ENV=development

# Session Encryption (AES-256-GCM - min 32 chars)
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars_long

# Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Credentials (for Drive Mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
